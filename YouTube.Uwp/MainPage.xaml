<Page
    x:Class="YouTube.Uwp.MainPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YouTube.Uwp.Models">
    <Page.Resources>
        <DataTemplate x:Key="VideoCardTemplate">
            <Border Background="{StaticResource PhoneCardBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="148" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                        <Border VerticalAlignment="Bottom" Background="#C0000000" Padding="10,7,10,7">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource PhoneCardTitleStyle}" TextWrapping="Wrap" MaxLines="2" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="10,8,10,10">
                        <TextBlock Text="{Binding ChannelTitle}" Foreground="{StaticResource PhoneHighlightBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PublishedAt}" Style="{StaticResource PhoneMetadataStyle}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PhonePivotHeaderTemplate">
            <Grid Width="{Binding Width}" Height="42">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="3" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource PhonePivotHeaderTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" />
                <Border Grid.Row="1" Background="{StaticResource PhoneAccentBrush}" Visibility="{Binding UnderlineVisibility}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="InlineCategoryVideoTemplate">
            <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="CategoryVideoButton_Click" Tag="{Binding}">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoCardTemplate}" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="CategoryTemplate">
            <Border Background="{StaticResource PhoneCardBrush}" Margin="0,0,0,8">
                <StackPanel>
                    <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="CategoryToggleButton_Click" Tag="{Binding}">
                        <Grid Height="52" Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource PhoneCardTitleStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ToggleGlyph}" FontSize="28" Foreground="{StaticResource PhoneAccentBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <StackPanel Visibility="{Binding ExpandedContentVisibility}" Margin="12,0,12,12">
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PhoneMetadataStyle}" Margin="0,2,0,8" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Videos}" ItemTemplate="{StaticResource InlineCategoryVideoTemplate}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SubscriptionTemplate">
            <Border Background="{StaticResource PhoneCardBrush}" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding ChannelTitle}" Style="{StaticResource PhoneCardTitleStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource PhoneMetadataStyle}" Margin="0,4,0,0" TextWrapping="Wrap" MaxLines="2" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PlaylistTemplate">
            <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="PlaylistButton_Click" Tag="{Binding}">
                <Border Background="{StaticResource PhoneCardBrush}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PhoneCardTitleStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding VideoCountLabel}" Style="{StaticResource PhoneMetadataStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="ProfileVideoTemplate">
            <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="ProfileVideoButton_Click" Tag="{Binding}">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoCardTemplate}" />
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{StaticResource PhonePageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PhoneHeaderBrush}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="38" Height="38" VerticalAlignment="Center" Stretch="Uniform" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="UNITUBE" FontFamily="Segoe UI Semibold" FontSize="20" Foreground="{StaticResource PhonePrimaryTextBrush}" />
                    <TextBlock Text="PUBLIC BROWSER" FontSize="10" Foreground="{StaticResource PhoneMutedTextBrush}" Margin="1,-3,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="SETTINGS" Style="{StaticResource PhoneOutlineButtonStyle}" Click="ShowSettingsButton_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource PhoneAccentBrush}" />

        <Pivot x:Name="MainPivot" Grid.Row="2" HeaderTemplate="{StaticResource PhonePivotHeaderTemplate}" Foreground="{StaticResource PhonePrimaryTextBrush}" SelectionChanged="MainPivot_SelectionChanged">
            <PivotItem>
                <PivotItem.Header>
                    <models:PivotHeader x:Name="HomePivotHeader" Label="HOME" Width="70" IsSelected="True" />
                </PivotItem.Header>
                <ScrollViewer>
                    <StackPanel Margin="16,18,16,28">
                        <TextBlock Text="discover" Style="{StaticResource PhonePageTitleStyle}" />
                        <TextBlock Text="The latest popular videos, in the classic phone-first layout." Style="{StaticResource PhoneMetadataStyle}" Margin="0,2,0,16" />

                        <Button Style="{StaticResource PhoneActionButtonStyle}" Click="PopularButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,12">
                            <Grid Height="64">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TRENDING NOW" FontSize="18" FontFamily="Segoe UI Semilight" />
                                    <TextBlock Text="Load popular videos for your region" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="›" FontSize="36" VerticalAlignment="Center" Margin="12,0,4,0" />
                            </Grid>
                        </Button>

                        <TextBlock Text="popular videos" Style="{StaticResource PhoneSectionTitleStyle}" />
                        <TextBlock x:Name="HomeStatusText" Style="{StaticResource PhoneMetadataStyle}" Text="Choose Trending Now to load public results." Margin="0,3,0,12" TextWrapping="Wrap" />
                        <ListView ItemsSource="{Binding Results}" ItemTemplate="{StaticResource VideoCardTemplate}" ItemContainerStyle="{StaticResource PhoneListItemStyle}" IsItemClickEnabled="True" ItemClick="ResultsList_ItemClick" SelectionMode="None" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem>
                <PivotItem.Header>
                    <models:PivotHeader x:Name="SearchPivotHeader" Label="SEARCH" Width="80" />
                </PivotItem.Header>
                <ScrollViewer>
                    <StackPanel Margin="16,18,16,28">
                        <TextBlock Text="search" Style="{StaticResource PhonePageTitleStyle}" />
                        <TextBlock Text="Find public YouTube videos with your user-supplied API key." Style="{StaticResource PhoneMetadataStyle}" Margin="0,2,0,16" />
                        <TextBox x:Name="SearchBox" Style="{StaticResource PhoneTextBoxStyle}" Header="Search terms" PlaceholderText="Search YouTube" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="SEARCH" Style="{StaticResource PhoneActionButtonStyle}" Click="SearchButton_Click" />
                            <Button Content="POPULAR" Style="{StaticResource PhoneOutlineButtonStyle}" Click="PopularButton_Click" />
                        </StackPanel>
                        <TextBlock Text="REGION" Style="{StaticResource PhoneMetadataStyle}" />
                        <ComboBox x:Name="RegionSelector" ItemsSource="{Binding Regions}" DisplayMemberPath="Name" SelectionChanged="RegionSelector_SelectionChanged" />
                        <TextBlock x:Name="RegionStatusText" Style="{StaticResource PhoneMetadataStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="PublicStatusText" Style="{StaticResource PhoneMetadataStyle}" Margin="0,4,0,12" TextWrapping="Wrap" />
                        <ListView ItemsSource="{Binding Results}" ItemTemplate="{StaticResource VideoCardTemplate}" ItemContainerStyle="{StaticResource PhoneListItemStyle}" IsItemClickEnabled="True" ItemClick="ResultsList_ItemClick" SelectionMode="None" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem>
                <PivotItem.Header>
                    <models:PivotHeader x:Name="CategoriesPivotHeader" Label="CATEGORIES" Width="105" />
                </PivotItem.Header>
                <ScrollViewer>
                    <StackPanel Margin="16,18,16,28">
                        <TextBlock Text="categories" Style="{StaticResource PhonePageTitleStyle}" />
                        <TextBlock Text="Tap a category to expand its current popular videos. Tap it again to collapse and choose another." Style="{StaticResource PhoneMetadataStyle}" Margin="0,2,0,16" TextWrapping="Wrap" />
                        <TextBlock x:Name="CategoryStatusText" Style="{StaticResource PhoneMetadataStyle}" Margin="0,0,0,12" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource CategoryTemplate}" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem>
                <PivotItem.Header>
                    <models:PivotHeader x:Name="ProfilePivotHeader" Label="PROFILE" Width="78" />
                </PivotItem.Header>
                <ScrollViewer>
                    <StackPanel Margin="16,18,16,28">
                        <TextBlock Text="profile" Style="{StaticResource PhonePageTitleStyle}" />
                        <TextBlock Text="Account data available through your authenticated YouTube connection." Style="{StaticResource PhoneMetadataStyle}" Margin="0,2,0,12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RefreshProfileButton" Content="REFRESH PROFILE" Style="{StaticResource PhoneActionButtonStyle}" Click="RefreshProfileButton_Click" />
                            <Button Content="UPLOAD VIDEO" Style="{StaticResource PhoneOutlineButtonStyle}" Click="ShowUploadButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ProfileStatusText" Style="{StaticResource PhoneMetadataStyle}" Margin="0,2,0,14" TextWrapping="Wrap" />

                        <Border Background="{StaticResource PhoneCardBrush}" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="ProfileTitleText" Style="{StaticResource PhoneSectionTitleStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ProfileMetadataText" Style="{StaticResource PhoneMetadataStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="ProfileDescriptionText" Style="{StaticResource PhoneMetadataStyle}" Margin="0,6,0,0" TextWrapping="Wrap" MaxLines="5" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PhoneCardBrush}" Margin="0,0,0,8">
                            <StackPanel>
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Click="ToggleUploadedVideosButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Grid Height="52" Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="uploaded videos" Style="{StaticResource PhoneSectionTitleStyle}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="UploadedVideosToggleGlyph" Grid.Column="1" Text="+" FontSize="28" Foreground="{StaticResource PhoneAccentBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <StackPanel x:Name="UploadedVideosContentPanel" Margin="12,0,12,12" Visibility="Collapsed">
                                    <TextBlock x:Name="UploadedVideosStatusText" Style="{StaticResource PhoneMetadataStyle}" Margin="0,3,0,8" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding UploadedVideos}" ItemTemplate="{StaticResource ProfileVideoTemplate}" />
                                    <Button x:Name="MoreUploadedVideosButton" Content="LOAD MORE UPLOADED VIDEOS" Style="{StaticResource PhoneOutlineButtonStyle}" Click="MoreUploadedVideosButton_Click" HorizontalAlignment="Left" IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PhoneCardBrush}" Margin="0,0,0,8">
                            <StackPanel>
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Click="ToggleSubscriptionsButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Grid Height="52" Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="subscriptions" Style="{StaticResource PhoneSectionTitleStyle}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SubscriptionsToggleGlyph" Grid.Column="1" Text="+" FontSize="28" Foreground="{StaticResource PhoneAccentBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <StackPanel x:Name="SubscriptionsContentPanel" Margin="12,0,12,12" Visibility="Collapsed">
                                    <TextBlock x:Name="SubscriptionsStatusText" Style="{StaticResource PhoneMetadataStyle}" Margin="0,3,0,8" TextWrapping="Wrap" />
                                    <ListView x:Name="SubscriptionsList" ItemsSource="{Binding Subscriptions}" ItemTemplate="{StaticResource SubscriptionTemplate}" SelectionMode="None" />
                                    <Button x:Name="MoreSubscriptionsButton" Content="LOAD MORE SUBSCRIPTIONS" Style="{StaticResource PhoneOutlineButtonStyle}" Click="MoreSubscriptionsButton_Click" HorizontalAlignment="Left" IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PhoneCardBrush}" Margin="0,0,0,8">
                            <StackPanel>
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Click="TogglePlaylistsButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Grid Height="52" Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="playlists" Style="{StaticResource PhoneSectionTitleStyle}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="PlaylistsToggleGlyph" Grid.Column="1" Text="+" FontSize="28" Foreground="{StaticResource PhoneAccentBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <StackPanel x:Name="PlaylistsContentPanel" Margin="12,0,12,12" Visibility="Collapsed">
                                    <TextBlock x:Name="PlaylistsStatusText" Style="{StaticResource PhoneMetadataStyle}" Margin="0,3,0,8" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding Playlists}" ItemTemplate="{StaticResource PlaylistTemplate}" />
                                    <Button x:Name="MorePlaylistsButton" Content="LOAD MORE PLAYLISTS" Style="{StaticResource PhoneOutlineButtonStyle}" Click="MorePlaylistsButton_Click" HorizontalAlignment="Left" IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PhoneCardBrush}" Margin="0,0,0,8">
                            <StackPanel>
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Click="TogglePlaylistVideosButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Grid Height="52" Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SelectedPlaylistText" Text="playlist videos" Style="{StaticResource PhoneSectionTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <TextBlock x:Name="PlaylistVideosToggleGlyph" Grid.Column="1" Text="+" FontSize="28" Foreground="{StaticResource PhoneAccentBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <StackPanel x:Name="PlaylistVideosContentPanel" Margin="12,0,12,12" Visibility="Collapsed">
                                    <TextBlock x:Name="PlaylistVideosStatusText" Style="{StaticResource PhoneMetadataStyle}" Margin="0,3,0,8" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding PlaylistVideos}" ItemTemplate="{StaticResource ProfileVideoTemplate}" />
                                    <Button x:Name="MorePlaylistVideosButton" Content="LOAD MORE PLAYLIST VIDEOS" Style="{StaticResource PhoneOutlineButtonStyle}" Click="MorePlaylistVideosButton_Click" HorizontalAlignment="Left" IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PhoneCardBrush}" Margin="0,0,0,8">
                            <StackPanel>
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Click="ToggleLikedVideosButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Grid Height="52" Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="liked videos" Style="{StaticResource PhoneSectionTitleStyle}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="LikedVideosToggleGlyph" Grid.Column="1" Text="+" FontSize="28" Foreground="{StaticResource PhoneAccentBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <StackPanel x:Name="LikedVideosContentPanel" Margin="12,0,12,12" Visibility="Collapsed">
                                    <TextBlock x:Name="LikedVideosStatusText" Style="{StaticResource PhoneMetadataStyle}" Margin="0,3,0,8" TextWrapping="Wrap" />
                                    <Button x:Name="LoadLikedVideosButton" Content="LOAD LIKED VIDEOS" Style="{StaticResource PhoneOutlineButtonStyle}" Click="LoadLikedVideosButton_Click" HorizontalAlignment="Left" />
                                    <ItemsControl ItemsSource="{Binding LikedVideos}" ItemTemplate="{StaticResource ProfileVideoTemplate}" />
                                    <Button x:Name="MoreLikedVideosButton" Content="LOAD MORE LIKED VIDEOS" Style="{StaticResource PhoneOutlineButtonStyle}" Click="MoreLikedVideosButton_Click" HorizontalAlignment="Left" IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="unsupported by YouTube Data API v3" Style="{StaticResource PhoneSectionTitleStyle}" Margin="0,14,0,0" />
                        <TextBlock Text="Watch History and Watch Later are not exposed as readable v3 collections. UniTube does not emulate or mislabel them." Style="{StaticResource PhoneMetadataStyle}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
