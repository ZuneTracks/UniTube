<Page
    x:Class="YouTube.Uwp.Views.UploadVideoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource PhonePageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource PhoneHeaderBrush}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Uid="BackButton" Content="‹ BACK" Style="{StaticResource PhoneOutlineButtonStyle}" Click="BackButton_Click" VerticalAlignment="Center" />
                <TextBlock x:Uid="UploadHeaderTitle" Grid.Column="1" Text="upload" Style="{StaticResource PhoneSectionTitleStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource PhoneAccentBrush}" />
        <ScrollViewer Grid.Row="2">
            <StackPanel Margin="16,18,16,28">
                <TextBlock x:Uid="UploadPageTitle" Text="upload video" Style="{StaticResource PhonePageTitleStyle}" />
                <TextBlock x:Uid="UploadPageDescription" Text="Select a local video, then upload it through your authorized Google account." Style="{StaticResource PhoneMetadataStyle}" Margin="0,2,0,16" TextWrapping="Wrap" />

                <Border Background="{StaticResource PhoneSurfaceBrush}" Padding="14">
                    <StackPanel>
                        <Button x:Uid="SelectVideoButton" Content="SELECT VIDEO" Style="{StaticResource PhoneActionButtonStyle}" Click="SelectVideoButton_Click" HorizontalAlignment="Left" />
                        <TextBlock x:Uid="SelectedFileText" x:Name="SelectedFileText" Text="No video selected." Style="{StaticResource PhoneMetadataStyle}" Margin="0,8,0,12" TextWrapping="Wrap" />
                        <TextBox x:Uid="TitleBox" x:Name="TitleBox" Style="{StaticResource PhoneTextBoxStyle}" Header="Title" PlaceholderText="Required" MaxLength="100" />
                        <TextBox x:Uid="DescriptionBox" x:Name="DescriptionBox" Style="{StaticResource PhoneTextBoxStyle}" Header="Description" PlaceholderText="Optional" AcceptsReturn="True" TextWrapping="Wrap" Height="120" MaxLength="5000" />
                        <ComboBox x:Uid="PrivacyBox" x:Name="PrivacyBox" Header="Privacy" SelectedIndex="0" Margin="0,0,0,8">
                            <ComboBoxItem x:Uid="PrivatePrivacyOption" Tag="private" Content="private" />
                            <ComboBoxItem x:Uid="UnlistedPrivacyOption" Tag="unlisted" Content="unlisted" />
                            <ComboBoxItem x:Uid="PublicPrivacyOption" Tag="public" Content="public" />
                        </ComboBox>
                        <TextBlock x:Uid="UploadRequirements" Text="Uploads require OAuth settings and a completed Google sign-in from Settings." Style="{StaticResource PhoneMetadataStyle}" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <ProgressBar x:Name="UploadProgressBar" Minimum="0" Maximum="100" Value="0" Height="8" Margin="0,4,0,0" />
                        <TextBlock x:Uid="UploadReadyStatus" x:Name="ProgressText" Text="Ready to select a video." Style="{StaticResource PhoneMetadataStyle}" Margin="0,6,0,8" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Uid="StartUploadButton" x:Name="UploadButton" Content="START UPLOAD" Style="{StaticResource PhoneActionButtonStyle}" Click="UploadButton_Click" />
                            <Button x:Uid="CancelButton" x:Name="CancelButton" Content="CANCEL" Style="{StaticResource PhoneOutlineButtonStyle}" Click="CancelButton_Click" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
