<Page
    x:Class="YouTube.Uwp.Views.ChannelDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource PhonePageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource PhoneHeaderBrush}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Uid="BackButton" Content="‹ BACK" Style="{StaticResource PhoneOutlineButtonStyle}" Click="BackButton_Click" VerticalAlignment="Center" />
                <TextBlock x:Uid="ChannelDetailsHeader" Grid.Column="1" Text="channel details" Style="{StaticResource PhoneSectionTitleStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource PhoneAccentBrush}" />
        <ScrollViewer Grid.Row="2">
            <StackPanel Margin="16,18,16,28">
                <TextBlock x:Name="StatusText" Style="{StaticResource PhoneMetadataStyle}" TextWrapping="Wrap" />
                <Border Background="{StaticResource PhoneCardBrush}" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="ThumbnailImage" Height="96" Width="96" Stretch="UniformToFill" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Style="{StaticResource PhoneSectionTitleStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="MetadataText" Style="{StaticResource PhoneMetadataStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Background="{StaticResource PhoneSurfaceBrush}" Padding="14">
                    <StackPanel>
                        <TextBlock x:Uid="ChannelAboutTitle" Text="about this channel" Style="{StaticResource PhoneSectionTitleStyle}" />
                        <TextBlock x:Name="DescriptionText" Foreground="{StaticResource PhoneSecondaryTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
