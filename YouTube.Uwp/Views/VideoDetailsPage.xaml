<Page
    x:Class="YouTube.Uwp.Views.VideoDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource PhonePageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource PhoneHeaderBrush}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Uid="BackButton" Content="‹ BACK" Style="{StaticResource PhoneOutlineButtonStyle}" Click="BackButton_Click" VerticalAlignment="Center" />
                <TextBlock x:Uid="VideoDetailsHeader" Grid.Column="1" Text="video details" Style="{StaticResource PhoneSectionTitleStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource PhoneAccentBrush}" />
        <ScrollViewer Grid.Row="2">
            <StackPanel Margin="16,18,16,28">
                <TextBlock x:Name="StatusText" Style="{StaticResource PhoneMetadataStyle}" TextWrapping="Wrap" />
                <Border Background="{StaticResource PhoneCardBrush}" Margin="0,0,0,14">
                    <Image x:Name="ThumbnailImage" Height="208" Stretch="UniformToFill" />
                </Border>
                <TextBlock x:Name="TitleText" Style="{StaticResource PhonePageTitleStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="ChannelText" Foreground="{StaticResource PhoneHighlightBrush}" FontSize="16" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="MetadataText" Style="{StaticResource PhoneMetadataStyle}" Margin="0,4,0,14" TextWrapping="Wrap" />
                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Uid="PlayInAppButton" x:Name="PlayInAppButton" Content="PLAY IN APP" Style="{StaticResource PhoneActionButtonStyle}" Click="PlayInAppButton_Click" IsEnabled="False" />
                        <Button x:Uid="WatchOnYouTubeButton" Content="WATCH ON YOUTUBE" Style="{StaticResource PhoneOutlineButtonStyle}" Click="WatchOnYouTubeButton_Click" />
                    </StackPanel>
                    <Button x:Uid="OpenChannelButton" Content="OPEN CHANNEL" Style="{StaticResource PhoneOutlineButtonStyle}" Click="OpenChannelButton_Click" HorizontalAlignment="Left" />
                </StackPanel>
                <TextBlock x:Name="PlaybackStatusText" Style="{StaticResource PhoneMetadataStyle}" Margin="0,-10,0,16" TextWrapping="Wrap" />
                <Border Background="{StaticResource PhoneSurfaceBrush}" Padding="14">
                    <StackPanel>
                        <TextBlock x:Uid="DescriptionTitle" Text="description" Style="{StaticResource PhoneSectionTitleStyle}" />
                        <TextBlock x:Name="DescriptionText" Foreground="{StaticResource PhoneSecondaryTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock x:Uid="InAppPlaybackDescription" Text="In-app playback uses YouTube's official mobile watch page. This app does not extract or download media URLs." Style="{StaticResource PhoneMetadataStyle}" Margin="0,14,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
