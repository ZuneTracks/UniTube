<Page
    x:Class="YouTube.Uwp.Views.VideoPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource PhonePageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource PhoneHeaderBrush}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Uid="BackButton" Content="‹ BACK" Style="{StaticResource PhoneOutlineButtonStyle}" Click="BackButton_Click" VerticalAlignment="Center" />
                <TextBlock x:Uid="PlayerTitle" Grid.Column="1" Text="player" Style="{StaticResource PhoneSectionTitleStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource PhoneAccentBrush}" />
        <TextBlock x:Name="StatusText" Grid.Row="2" Style="{StaticResource PhoneMetadataStyle}" Margin="16,10,16,10" TextWrapping="Wrap" />
        <WebView x:Name="PlayerWebView" Grid.Row="3" NavigationCompleted="PlayerWebView_NavigationCompleted" NavigationFailed="PlayerWebView_NavigationFailed" />
        <Border Grid.Row="4" Background="{StaticResource PhoneHeaderBrush}" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Uid="OpenInBrowserButton" Content="OPEN IN BROWSER" Style="{StaticResource PhoneOutlineButtonStyle}" Click="OpenInBrowserButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
